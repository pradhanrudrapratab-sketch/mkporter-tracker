# ── REQUIRED ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/porter_tracker

# Strong random secret for session/encryption (generate with: openssl rand -hex 32)
APP_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Your app's public URL (no trailing slash)
APP_URL=http://localhost:8080

# ── OPTIONAL ───────────────────────────────────────────────────────────────────
APP_ENV=development
PORT=8080
LOG_LEVEL=debug
APP_TIMEZONE=Asia/Kolkata

# Tracking interval in seconds (default: 30)
TRACK_INTERVAL_SECONDS=30

# Delay after ride completion before sending Telegram report (default: 600 = 10 min)
REPORT_DELAY_SECONDS=600

# Days of inactivity before user account is deleted (default: 30)
INACTIVE_DAYS=30
